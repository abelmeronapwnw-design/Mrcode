-- 6. FUNCIÓN PRINCIPAL DE TP (con movimiento real)
-- ================================================================
local function doFullTP()
    print("[SXE_TP] Iniciando TP completo...")

    -- Cargar módulos si no lo están
    if not modulesLoaded then
        loadModules()
    end

    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then
        print("[SXE_TP] Personaje no listo.")
        return
    end

    -- 1. ESCANEAR MASCOTAS (avanzado o simple)
    local pets = scanPetsAdvanced()
    if not pets or #pets == 0 then
        print("[SXE_TP] Falló escaneo avanzado, usando simple.")
        pets = scanPetsSimple()
    end

    if not pets or #pets == 0 then
        print("[SXE_TP] No se encontraron mascotas. TP cancelado.")
        return
    end

    -- Elegir la de mayor generación (ya ordenada por mps)
    local target = pets[1]
    -- También podríamos elegir por prioridad si quieres, pero como dijiste híbrido, prioridad primero, si no, mayor gen.
    -- En este script, como usamos orden por mps, ya es mayor gen.
    -- Si quieres prioridad, podemos agregar una función que filtre por priorityList.
    -- Por ahora, elige la de mayor mps.
    local targetPos = target.position
    print("[SXE_TP] Objetivo: " .. target.name .. " (Gen: " .. tostring(target.mps or 0) .. ") en " .. tostring(targetPos))

    -- 2. MOVIMIENTO

    -- Equipar carpeta
    equipCarpet()

    -- Volar hacia el objetivo (primera aproximación)
    local function flyTo(pos, speed)
        speed = speed or 160
        local startTime = os.clock()
        while hrp.Parent and (os.clock() - startTime) < 6 do
            local diff = pos - hrp.Position
            local flatDist = Vector3.new(diff.X, 0, diff.Z).Magnitude
            if flatDist < 5 then break end
            hrp.AssemblyLinearVelocity = diff.Unit * speed
            RunService.Heartbeat:Wait()
        end
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end

    print("[SXE_TP] Volando hacia objetivo...")
    flyTo(targetPos, 160)

    -- Si está en segunda/tercera planta (Y > 8.9), usamos el clon
    local isUpper = targetPos.Y > 8.9

    if isUpper then
        print("[SXE_TP] Objetivo en piso superior, usando clon.")
        -- Buscar punto de cielo adecuado
        local coordTable = UPPER
        local skyPoint = findClosest(targetPos, coordTable)
        if skyPoint then
            local destPos = skyPoint.coord
            local facingDir = skyPoint.facing == "NORTH" and Vector3.new(0,0,-1) or Vector3.new(0,0,1)

            -- Volar al punto de cielo
            print("[SXE_TP] Volando al punto de cielo...")
            flyTo(destPos, 160)

            -- Disparar gancho
            print("[SXE_TP] Disparando gancho...")
            fireGrapple()
            task.wait(0.3)

            -- Ejecutar clon
            print("[SXE_TP] Ejecutando clon...")
            local cloneOk = doClone()
            if cloneOk then
                print("[SXE_TP] Clon exitoso.")
                task.wait(0.5)
                -- Volar al objetivo final
                flyTo(targetPos, 160)
                hrp.CFrame = CFrame.new(targetPos)
                hrp.AssemblyLinearVelocity = Vector3.zero
                print("[SXE_TP] TP completado (piso superior).")
            else
                print("[SXE_TP] Falló el clon. TP incompleto.")
            end
        else
            print("[SXE_TP] No se encontró punto de cielo. TP incompleto.")
        end
    else
        -- Primera planta: solo volar
        print("[SXE_TP] Objetivo en primera planta, volando directo.")
        flyTo(targetPos, 160)
        hrp.CFrame = CFrame.new(targetPos)
        hrp.AssemblyLinearVelocity = Vector3.zero
        print("[SXE_TP] TP completado (primera planta).")
    end
end

