-- Cargar módulos al inicio
loadModules()

-- Esperar a que el personaje esté listo
local function waitForCharacter()
    if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then return end
    LP.CharacterAdded:Wait()
    LP.Character:WaitForChild("HumanoidRootPart", 10)
end
waitForCharacter()

print("[AutoTP] Sistema listo. Presiona la tecla 'T' para teleportar, o llama a doVelocityTP() manualmente.")

-- Asignar a tecla T (opcional)
UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.T then
        task.spawn(doVelocityTP)
    end
end)

-- También exponer globalmente para llamadas manuales
_G.AutoTP = doVelocityTP
