local function getClosestBaseIdx(pos)
    local bases = {
        Vector3.new(-476.52,-2,220.94), Vector3.new(-476.52,-2,113.77),
        Vector3.new(-476.52,-2,6.18),   Vector3.new(-476.52,-2,-101.07),
        Vector3.new(-342.66,-2,221.45), Vector3.new(-342.66,-2,113.41),
        Vector3.new(-342.66,-2,6.25),   Vector3.new(-342.66,-2,-99.73),
    }
    local closest, dist = 1, math.huge
    for i, b in ipairs(bases) do
        local d = (pos.X - b.X)^2 + (pos.Z - b.Z)^2
        if d < dist then dist = d; closest = i end
    end
    return closest
end

local function buildFrontCandidate(idx, isUpper, playerZ)
    local base = isUpper and {
        Vector3.new(-479.51,18,220.94), Vector3.new(-479.51,18,113.77),
        Vector3.new(-479.51,18,6.18),   Vector3.new(-479.51,18,-101.07),
        Vector3.new(-339.48,18,221.45), Vector3.new(-339.48,18,113.41),
        Vector3.new(-339.48,18,6.25),   Vector3.new(-339.48,18,-99.73),
    }[idx] or {
        Vector3.new(-476.52,-2,220.94), Vector3.new(-476.52,-2,113.77),
        Vector3.new(-476.52,-2,6.18),   Vector3.new(-476.52,-2,-101.07),
        Vector3.new(-342.66,-2,221.45), Vector3.new(-342.66,-2,113.41),
        Vector3.new(-342.66,-2,6.25),   Vector3.new(-342.66,-2,-99.73),
    }[idx]
    local frontY = isUpper and 16.850713 or -3.048217
    local frontZ = math.clamp(playerZ - base.Z, -18, 18) + base.Z
    local coord = Vector3.new(base.X, frontY, frontZ)
    local faceDir = (idx <= 4) and Vector3.new(-1,0,0) or Vector3.new(1,0,0)
    return coord, faceDir
end

local function plotSides(coordTable, idx)
    local bases = {
        Vector3.new(-476.52,-2,220.94), Vector3.new(-476.52,-2,113.77),
        Vector3.new(-476.52,-2,6.18),   Vector3.new(-476.52,-2,-101.07),
        Vector3.new(-342.66,-2,221.45), Vector3.new(-342.66,-2,113.41),
        Vector3.new(-342.66,-2,6.25),   Vector3.new(-342.66,-2,-99.73),
    }
    local base = bases[idx]
    local isWest = idx <= 4
    local out = {}
    for _, coords in pairs(coordTable) do
        for _, data in ipairs(coords) do
            if ((data.coord.X < -410) == isWest) and math.abs(data.coord.Z - base.Z) < 45 then
                out[#out + 1] = data
            end
        end
    end
    return out
end

local function findClosest(petPos, coordTable)
    local best, bestDist = nil, math.huge
    for skyKey, coords in pairs(coordTable) do
        for _, data in ipairs(coords) do
            local d = (petPos - data.coord).Magnitude
            if d < bestDist then bestDist = d; best = data; end
        end
    end
    return best
end

-- ================================================================
-- 7. FUNCIÓN PRINCIPAL DE TELEPORT
-- ================================================================

local function doVelocityTP()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    -- Escanear mascotas
    local allPets = scanAllPets()
    if #allPets == 0 then
        print("[AutoTP] No se encontraron mascotas")
        return
    end

    -- Seleccionar según modo
    local pet
    if CONFIG.StealMode == "Nearest" then
        local bestDist = math.huge
        for _, p in ipairs(allPets) do
            if p.position then
                local d = (hrp.Position - p.position).Magnitude
                if d < bestDist then bestDist = d; pet = p end
            end
        end
    elseif CONFIG.StealMode == "Highest" then
        local bestMPS = -1
        for _, p in ipairs(allPets) do
            if p.mps and p.mps > bestMPS then bestMPS = p.mps; pet = p end
        end
    else -- Priority
        pet = allPets[1]  -- ya ordenado por priorityList
    end

    if not pet then print("[AutoTP] No se pudo seleccionar una mascota") return end

    local petPos = pet.position
    local petName = pet.name
    print("[AutoTP] Teleportando a " .. petName .. " (gen: " .. tostring(pet.mps) .. ")")

    -- Velocidades
    local tpSpeed = CONFIG.GrabbleTPSpeed
    local cloneDelay = CONFIG.CloneDelay

    -- Determinar si es primera o segunda planta
    local isUpper = petPos.Y > 8.9

    if not isUpper then
        -- Primera planta: vuelo directo
        equipCarpet()
        local toPos = Vector3.new(petPos.X, -4, petPos.Z)
        local idx = getClosestBaseIdx(petPos)
        local _, faceDir = buildFrontCandidate(idx, false, hrp.Position.Z)
        local route = computeRoute(hrp.Position, toPos)
        if #route > 0 then
            velMoveThrough(hrp, route, CONFIG.FlyTPSpeed, true)
        end
        hrp.CFrame = CFrame.new(toPos, toPos + faceDir)
        hrp.AssemblyLinearVelocity = Vector3.zero
        task.wait(0.5)
        return
    end

    -- Segunda planta: usar clon
    local coordTable = UPPER  -- para segunda planta
    local skyPoint = findClosest(petPos, coordTable)
    if not skyPoint then return end

    local destPos = skyPoint.coord
    local facingDir = skyPoint.facing == "NORTH" and Vector3.new(0,0,-1) or Vector3.new(0,0,1)

    -- Equipar carpeta y volar al punto de cielo
    equipCarpet()
    local idx = getClosestBaseIdx(petPos)
    local frontCoord, frontFace = buildFrontCandidate(idx, true, hrp.Position.Z)
    local bestCoord, bestFace = frontCoord, frontFace
    local bestDist = (hrp.Position - frontCoord).Magnitude
    for _, d in ipairs(plotSides(coordTable, idx)) do
        local dd = (hrp.Position - d.coord).Magnitude
        if dd < bestDist then bestDist = dd; bestCoord = d.coord; bestFace = d.facing == "NORTH" and Vector3.new(0,0,-1) or Vector3.new(0,0,1) end
    end
    destPos = bestCoord
    facingDir = bestFace

    local route = computeRoute(hrp.Position, destPos)
    if #route > 0 then
        velMoveThrough(hrp, route, CONFIG.FlyTPSpeed, true)
    end
    hrp.CFrame = CFrame.new(destPos, destPos + facingDir)
    hrp.AssemblyLinearVelocity = Vector3.zero

    -- Disparar gancho y esperar
    fireGrapple()
    task.wait(0.3)

    -- Clonar
    task.wait(cloneDelay)
    local cloneOk = doClone()
    if cloneOk then
        print("[AutoTP] Clon exitoso, moviendo a la mascota")
        -- Moverse cerca de la mascota (con carpeta)
        equipCarpet()
        local targetPos = Vector3.new(petPos.X, petPos.Y - 4, petPos.Z)
        local route2 = computeRoute(hrp.Position, targetPos)
        if #route2 > 0 then
            velMoveThrough(hrp, route2, CONFIG.WalkTPSpeed, true)
        end
        hrp.CFrame = CFrame.new(targetPos)
    else
        print("[AutoTP] Falló el clon")
    end
end

