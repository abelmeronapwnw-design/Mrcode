-- 5. MOVIMIENTO (velMoveThrough, computeRoute, etc.)
-- ================================================================

local PathfindingService = game:GetService("PathfindingService")

local function _blocks(inst)
    if not inst then return false end
    local skip = { ["DeliveryHitbox"]=true, ["StealHitbox"]=true, ["LaserHitbox"]=true,
        ["AnimalTarget"]=true, ["Multiplier"]=true, ["Laser"]=true, ["Hitbox"]=true,
        ["Spawn"]=true, ["MainRoot"]=true, ["SecondFloor"]=true, ["ThirdFloor"]=true, ["Slope"]=true }
    if skip[inst.Name] then return false end
    if inst.CanCollide then return true end
    local s = inst.Size
    if s and math.max(s.X*s.Y, s.X*s.Z, s.Y*s.Z) > 150 then return true end
    return false
end

local function _block(origin, target)
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.IgnoreWater = true
    local skip = {}
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl.Character then skip[#skip + 1] = pl.Character end
    end
    local o = origin
    for _ = 1, 16 do
        rp.FilterDescendantsInstances = skip
        local d = target - o
        if d.Magnitude < 0.05 then return nil end
        local res = Workspace:Raycast(o, d, rp)
        if not res then return nil end
        if _blocks(res.Instance) then return res end
        skip[#skip + 1] = res.Instance
        o = res.Position + d.Unit * 0.3
    end
    return nil
end

local function _clear(a, b) return _block(a, b) == nil end

local function _clearWideRay(a, b)
    return _block(a, b) == nil
end

local function _clearWide(a, b)
    if not _clear(a, b) then return false end
    local d = Vector3.new(b.X - a.X, 0, b.Z - a.Z)
    if d.Magnitude < 0.1 then return true end
    local perp = Vector3.new(-d.Z, 0, d.X).Unit * 10
    local up = Vector3.new(0, 10, 0)
    return _clearWideRay(a + perp, b + perp) and _clearWideRay(a - perp, b - perp)
        and _clearWideRay(a + up, b + up) and _clearWideRay(a - up, b - up)
end

local function _pullWide(pts)
    if #pts <= 2 then return pts end
    local out = { pts[1] }
    local i = 1
    while i < #pts do
        local j = #pts
        while j > i + 1 and not _clearWide(out[#out], pts[j]) do j = j - 1 end
        out[#out + 1] = pts[j]
        i = j
    end
    return out
end

local function computeRoute(fromPos, toPos)
    if _clear(fromPos, toPos) then return { toPos } end
    local path = PathfindingService:CreatePath({
        AgentRadius = 12, AgentHeight = 5, AgentCanJump = true,
        AgentJumpHeight = 10, AgentMaxSlope = 89
    })
    local nav = { fromPos }
    local ok = pcall(function()
        path:ComputeAsync(Vector3.new(fromPos.X, fromPos.Y, fromPos.Z),
                          Vector3.new(toPos.X, fromPos.Y, toPos.Z))
    end)
    if ok and path.Status == Enum.PathStatus.Success then
        local last = fromPos
        for _, wp in ipairs(path:GetWaypoints()) do
            if (wp.Position - last).Magnitude >= 8 then
                nav[#nav + 1] = wp.Position + Vector3.new(0, 3, 0)
                last = wp.Position
            end
        end
    end
    nav[#nav + 1] = toPos
    return _pullWide(nav)
end

local function velMoveThrough(hrp, waypoints, speed, allowJump)
    if not hrp or #waypoints == 0 then return end
    local wpIdx = 1
    local done = false
    local conn
    local function finish()
        if done then return end
        done = true
        if hrp and hrp.Parent then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
        if conn then conn:Disconnect() end
    end
    conn = RunService.Heartbeat:Connect(function()
        if not hrp or not hrp.Parent or done then conn:Disconnect(); return end
        local target = waypoints[wpIdx]
        local diff = target - hrp.Position
        local mag = diff.Magnitude
        if mag < 3 then
            wpIdx = wpIdx + 1
            if wpIdx > #waypoints then finish(); return end
            target = waypoints[wpIdx]; diff = target - hrp.Position; mag = diff.Magnitude
        end
        if mag >= 0.1 then
            local dir = diff.Unit
            if allowJump and diff.Y > 5 and wpIdx < #waypoints then
                local hum = hrp.Parent and hrp.Parent:FindFirstChildOfClass("Humanoid")
                if hum and hum:GetState() ~= Enum.HumanoidStateType.Jumping then
                    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
                end
            end
            hrp.AssemblyLinearVelocity = dir * speed
        end
    end)
    local totalDist = 0
    local prev = hrp.Position
    for _, wp in ipairs(waypoints) do totalDist = totalDist + (prev - wp).Magnitude; prev = wp end
    local timeout = totalDist / speed + 2
    local elapsed = 0
    while not done and elapsed < timeout do task.wait(0.05); elapsed = elapsed + 0.05 end
    finish()
    if hrp and hrp.Parent then hrp.AssemblyLinearVelocity = Vector3.zero end
end

